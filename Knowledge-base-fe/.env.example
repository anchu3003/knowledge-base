# Frontend env (KB-4.1) — copy sang `.env.local` khi chạy local.
# Lưu ý: `NEXT_PUBLIC_*` được nhúng vào bundle **lúc build** ⇒ đổi giá trị phải build lại.

# URL backend mà BROWSER gọi trực tiếp (BE mặc định http://localhost:8000).
NEXT_PUBLIC_API_PROXY_URL=http://localhost:8000

# Streaming SSE `POST /chat/stream` (KB-4.4) — bật mặc định. Đặt `false` để quay lại `/chat` blocking.
NEXT_PUBLIC_STREAMING=true

# Auth token (KB-5.5) — **mặc định TẮT**. Bật cùng lúc với BE: `AUTH_ENABLED=true` + `API_TOKEN=...`.
# Token KHÔNG nằm trong env này (NEXT_PUBLIC_* là công khai): người dùng nhập ở màn hình "Cần API token",
# lưu trong localStorage của trình duyệt.
NEXT_PUBLIC_AUTH_ENABLED=false
