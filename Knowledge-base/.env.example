# ==========================================
# RAG Chatbot API Configuration
# ==========================================
# Copy this file to .env and update with your actual values
# This file is used by both Python and Docker Compose

# ==========================================
# 🔑 LLM Provider Configuration (OpenAI-compatible)
# ==========================================
# Provider mặc định: Groq (free tier) — xem docs/adr/0001-llm-provider-groq.md
# Lấy key tại: https://console.groq.com/keys
OPENAI_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_TYPE=openai
# Chỉ dùng cho provider kiểu Azure (`OPENAI_API_TYPE=azure`); Groq/OpenAI-compatible để mặc định.
OPENAI_API_VERSION=2023-05-15
# Embeddings chạy LOCAL (sentence-transformers) — biến dưới chỉ để tương thích, không tốn API
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
# Model embedding local (KB-6.2). Đổi model ⇒ PHẢI re-index (xoá chroma_db hoặc POST /documents/refresh)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Provider thay thế (đổi 3 dòng trên là xong) ---
# Google Gemini : OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  | OPENAI_MODEL=gemini-2.5-flash
# OpenRouter    : OPENAI_BASE_URL=https://openrouter.ai/api/v1                               | OPENAI_MODEL=deepseek/deepseek-chat-v3:free
# Ollama (local): OPENAI_BASE_URL=http://localhost:11434/v1                                  | OPENAI_MODEL=llama3.2:3b

# ==========================================
# 🔒 PII / Secret redaction (xem .clinerules/30-pii-safety.md)
# ==========================================
# Che PII/secret trước khi gửi lên LLM (mặc định BẬT)
ENABLE_PII_REDACTION=true
PII_PLACEHOLDER=[REDACTED:{type}]
# Che PII trong tài liệu trước khi index vào ChromaDB (mặc định TẮT)
PII_REDACT_INGEST=false

# ==========================================
# ⚙️ Application Settings
# ==========================================
DEBUG=False

# ==========================================
# 🧠 ChromaDB Settings
# ==========================================
# In Docker, this will be mapped to /app/chroma_db
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=documents

# ==========================================
# 📄 Document Folder Settings
# ==========================================
# Path to folder containing documents to load
DOCUMENTS_FOLDER='Interview'
# Whether to load docs automatically on startup
AUTO_LOAD_ON_STARTUP=true

# ==========================================
# 🪄 Document Processing Settings
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=10
EMBEDDING_BATCH_SIZE=64
# Kiểu số thực khi embed trên CPU (KB-5.14 — trả TD-14).
# Model Qwen3 mặc định bf16, nhưng CPU không có kernel bf16 nhanh: đo 601 chunk thật
# ⇒ bf16 ~22 phút, float32 ~7,3 phút (nhanh ~3×). `default` = để model tự quyết (bf16).
# ⚠️ Đổi giá trị ⇒ **re-index toàn bộ** (`DELETE /documents/clear` rồi `POST /documents/sync`).
EMBEDDING_TORCH_DTYPE=float32

# ==========================================
# 🔍 RAG Settings
# ==========================================
# KB-9.1: corpus 234 file / 2.879 chunk (từ 56/601) ⇒ k=3 quá nông, file nguồn đúng rơi hạng 7.
RETRIEVAL_K=6
# Ngưỡng cosine tối thiểu cho dense candidates (0 = tắt). KHÔNG áp cho score hybrid/rerank
# (khác scale). Giá trị thật sẽ đo ở KB-2.5 — đừng bật khi chưa đo kẻo mất recall.
SIMILARITY_THRESHOLD=0.0

# Hậu xử lý kết quả retrieval (KB-2.2) — chống "5 tài liệu giống nhau"
# Bỏ chunk gần trùng nội dung (Jaccard shingle 3-gram >= ngưỡng)
DEDUP_ENABLED=true
DEDUP_JACCARD_THRESHOLD=0.8
# Tối đa số chunk của cùng 1 file trong top-k (0 = tắt)
MAX_CHUNKS_PER_FILE=2

# Hybrid retrieval and re-ranking
ENABLE_BM25=true
ENABLE_HYBRID=true
HYBRID_ALPHA=0.5
HYBRID_CANDIDATE_K=20

ENABLE_RERANK=true
# Rerank top-N — đo bằng `eval/run_eval.py` (bộ vàng v3 = 20 câu, cache tắt):
#   top-8 + mq ON (cũ) : hit@k 1.0 · MRR 0.975 · precision@k 0.617 · p50 6.500 s
#   top-6 + mq ON (chốt): hit@k 1.0 · MRR 0.975 · precision@k 0.617 · distinct 0.783 · p50 **3.439 s** (−47%)
#   top-4 + mq ON : MRR 0.883 · precision 0.483 (tụt >5% ⇒ không dùng)
RERANK_TOP_N=6
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Cache điểm rerank trong RAM (KB-5.3): cùng câu hỏi + index chưa đổi ⇒ trả ngay (0s thay vì ~4.5s).
# Khoá cache = query + `index_version` + tham số ⇒ sync/refresh tài liệu là tự vô hiệu.
RERANK_CACHE_ENABLED=true
# TTL (giây) — 0 = không hết hạn (chỉ vô hiệu khi index đổi).
RERANK_CACHE_TTL_SECONDS=3600
RERANK_CACHE_MAX_ENTRIES=256

# Rewrite setting
ENABLE_QUERY_REWRITE=true
REWRITE_MIN_RESULTS=2
REWRITE_MIN_TOP_SCORE=0.3
REWRITE_MAX_ATTEMPTS=2

# Multi-query (KB-5.4): câu hỏi **nhiều ý** ("A và B khác nhau thế nào?") được tách bằng heuristic
# (0 token LLM) rồi retrieve từng phần + gộp ⇒ top-k phủ nhiều ý hơn.
# Đo (eval 20 câu vàng, rerank on, cache tắt): precision@k 0,533 → **0,617**, hit@k/MRR giữ nguyên,
# latency_p50 9,70 → 6,50 s (mỗi phần chỉ chấm top-N/2 ứng viên). Tắt ⇒ quay lại retrieve 1 bước.
MULTI_QUERY_ENABLED=true
# Tối đa số phần tách ra (phần dư gộp vào phần cuối).
MULTI_QUERY_MAX_PARTS=3

# ==========================================
# 💬 Chat Settings
# ==========================================
MAX_CONVERSATION_LENGTH=10
# KB-9.1: hạ temperature + nới max_tokens vì Q&A tra cứu cần bám tài liệu và câu trả lời nhiều ý
# (đo: temp 0.7/max 1000 làm câu bị **cắt giữa câu** ở ~1.500 ký tự; 0.1/2000 thì đủ ý và gọn hơn)
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=2500

# ==========================================
# 💾 Conversation history (KB-5.2 — persistent, SQLite)
# ==========================================
# 1 file SQLite, bind mount `./data` trong docker-compose ⇒ sống qua restart.
# Để rỗng (CHAT_DB_PATH=) ⇒ tắt persistence, chat chỉ in-memory (mất khi restart).
# Log level cho logger `app.*` (KB-5.9 — trả TD-18). DEBUG/INFO/WARNING/ERROR.
# INFO ⇒ thấy log nghiệp vụ (multi-query, rerank cache hit, conversation store...).
# ==========================================
# 🔐 Auth (KB-5.5) — mặc định TẮT
# ==========================================
# Bật khi mở LAN/VPS: AUTH_ENABLED=true + API_TOKEN=<chuỗi dài ngẫu nhiên>
# Client gửi header `X-API-Key`. Bật mà API_TOKEN rỗng ⇒ **chặn tất cả** (fail-closed).
# Endpoint công khai khi bật: `/` và `/health` (healthcheck Docker). `/ready` bị bảo vệ.
AUTH_ENABLED=false
API_TOKEN=

# ==========================================
# 🚦 Rate limit (KB-5.15 — trả TD-20) — mặc định TẮT
# ==========================================
# Chặn 1 IP gọi dồn dập `/chat` + `/chat/stream` (mỗi câu tốn rerank CPU + quota provider).
# Bật cùng lúc với auth khi mở LAN/VPS. 429 trả về kèm header `Retry-After`.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Index sync lúc khởi động chạy **nền** (KB-5.16 — trả TD-25) ⇒ app nhận request ngay.
# Trạng thái xem ở `/ready` (`checks.startup_sync`) hoặc `/documents/status`.
# Đặt `false` để quay lại hành vi cũ (await sync xong mới phục vụ).
STARTUP_SYNC_BACKGROUND=true

LOG_LEVEL=INFO
CHAT_DB_PATH=./data/chat.db
# Giữ tối đa bao nhiêu session (cũ nhất bị xoá khi vượt).
MAX_CONVERSATIONS=200

# ==========================================
# 🚦 Provider resilience (KB-3.2)
# ==========================================
# Groq free tier chỉ có TPM 8000 ⇒ retry có ngân sách + serialize call tới provider.
# Timeout đẩy vào SDK; retry do service quyết định (SDK max_retries=0).
PROVIDER_TIMEOUT_SECONDS=60
# Số lần retry tối đa cho 429/5xx/timeout (2 ⇒ chờ tối đa ~6s trước khi trả lỗi)
PROVIDER_MAX_RETRIES=2
# Base delay (giây) cho exponential backoff + jitter: 2, 4, 8… (Retry-After của provider được ưu tiên)
PROVIDER_RETRY_BASE_DELAY=2.0
# Số call provider đồng thời tối đa (1 = serialize, tránh vượt TPM khi 2 request cùng lúc)
PROVIDER_MAX_CONCURRENCY=1

# ==========================================
# 📡 SSE — /chat/stream (KB-3.3)
# ==========================================
# Gửi comment `: ping` nếu quá N giây không có token (giữ kết nối qua proxy/idle timeout)
SSE_HEARTBEAT_SECONDS=15

# ==========================================
# 🗒️ Prompt Settings
# ==========================================
# Path to the system prompt template file. Use `{context}` placeholder where
# the retrieved document context should be inserted.
SYSTEM_PROMPT_PATH=./prompts/system_prompt.txt
REWRITE_SYSTEM_PROMPT_PATH=./prompts/rewrite_system_prompt.txt
# Tổng budget ký tự của retrieved context trong prompt (KB-2.3)
CONTEXT_MAX_CHARS=6000

# ==========================================
# 📂 Supported File Extensions
# ==========================================
SUPPORTED_EXTENSIONS=[".md",".txt",".docx",".pdf"]

# ==========================================
# 🌐 CORS — origin của FE được phép gọi API (phân tách bằng dấu phẩy)
# Dev: 3000 · Compose (KB-4.7 dời port): 3010
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010,http://127.0.0.1:3000,http://127.0.0.1:3010
