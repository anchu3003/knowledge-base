# ==========================================
# RAG Chatbot API Configuration
# ==========================================
# Copy this file to .env and update with your actual values
# This file is used by both Python and Docker Compose

# ==========================================
# 🔑 OpenAI Configuration (Required)
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=GPT-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_BASE_URL=https://aiportalapi.stu-platform.live/jpe
OPENAI_API_TYPE=openai

# ==========================================
# ⚙️ Application Settings
# ==========================================
DEBUG=False
APP_NAME=RAG_Chatbot_API
APP_VERSION=1.0.0

# ==========================================
# 🧠 ChromaDB Settings
# ==========================================
# In Docker, this will be mapped to /app/chroma_db
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=documents

# ==========================================
# 📄 Document Folder Settings
# ==========================================
# Path to folder containing documents to load
DOCUMENTS_FOLDER=./Interview
# Whether to load docs automatically on startup
AUTO_LOAD_ON_STARTUP=true

# ==========================================
# 🪄 Document Processing Settings
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=10
EMBEDDING_BATCH_SIZE=64

# ==========================================
# 🔍 RAG Settings
# ==========================================
RETRIEVAL_K=5
SIMILARITY_THRESHOLD=0.7

# Hybrid retrieval and re-ranking
ENABLE_BM25=true
ENABLE_HYBRID=true
HYBRID_ALPHA=0.5
HYBRID_CANDIDATE_K=20

ENABLE_RERANK=true
RERANK_TOP_N=20
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Rewrite setting
ENABLE_QUERY_REWRITE=true
REWRITE_MIN_RESULTS=2
REWRITE_MIN_TOP_SCORE=0.3
REWRITE_MAX_ATTEMPTS=2

# ==========================================
# 💬 Chat Settings
# ==========================================
MAX_CONVERSATION_LENGTH=10
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000

# ==========================================
# 🗒️ Prompt Settings
# ==========================================
# Path to the system prompt template file. Use `{context}` placeholder where
# the retrieved document context should be inserted.
SYSTEM_PROMPT_PATH=./prompts/system_prompt.txt
REWRITE_SYSTEM_PROMPT_PATH=./prompts/rewrite_system_prompt.txt

# ==========================================
# 📂 Supported File Extensions
# ==========================================
SUPPORTED_EXTENSIONS=[".md",".txt",".docx",".pdf"]
