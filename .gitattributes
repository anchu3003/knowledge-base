# Chuẩn hoá EOL cho toàn monorepo: mọi file text = LF.
# (Dev trên WSL2/Ubuntu — KB-7.1; tránh churn CRLF khi file đi qua Windows.)
* text=auto eol=lf

# Binary — không normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
*.gz binary

# ChromaDB / model artifacts không phải text
chroma_db/** -text
